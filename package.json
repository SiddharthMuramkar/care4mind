{
  "name": "care4mind",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "node scripts/content/registry.mjs && next dev",
    "build": "node scripts/content/registry.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/content/registry.mjs && next typegen && tsc --noEmit && tsc -p scripts --noEmit",
    "test": "node scripts/content/registry.mjs && vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/content/registry.mjs && playwright test",
    "check": "node scripts/content/registry.mjs && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "check:e2e": "playwright test",
    "lhci": "lhci autorun",
    "shots": "node scripts/shots.mjs",
    "icons": "node scripts/icons.mjs",
    "content:new": "node scripts/content/new.mjs",
    "ruleset:check": "node scripts/github/ruleset.mjs",
    "ruleset:apply": "node scripts/github/apply-ruleset.mjs",
    "prepare": "node scripts/githooks/install.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
