{
  "name": "care4mind",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.x",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "node scripts/content/registry.mjs && next dev",
    "build": "node scripts/content/registry.mjs && next build",
    "start": "next start",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "format": "prettier --write .",
    "format:check": "prettier --check --cache .",
    "typecheck": "node scripts/content/registry.mjs && next typegen && tsc --noEmit && tsc -p scripts --noEmit",
    "test": "node scripts/content/registry.mjs && vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/content/registry.mjs && playwright test",
    "check": "node scripts/content/registry.mjs && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "check:e2e": "playwright test",
    "check:e2e:off": "FEATURE_LOGIN=0 pnpm build && FEATURE_LOGIN=0 E2E_ONLY=login-off playwright test",
    "lhci": "lhci autorun",
    "shots": "node scripts/shots.mjs",
    "icons": "node scripts/icons.mjs",
    "art": "node scripts/art/process.mjs",
    "art:fetch": "node scripts/art/fetch.mjs",
    "content:new": "node scripts/content/new.mjs",
    "content:verify": "node scripts/content/registry.mjs && node scripts/content/verify.mjs",
    "content:report": "node scripts/content/registry.mjs && node scripts/content/report.mjs",
    "content:fidelity": "vitest run --config vitest.fidelity.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@vercel/functions": "3.11.0",
    "better-auth": "1.7.18",
    "botid": "1.5.12",
    "disposable-email-domains-js": "1.26.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-socket": "0.2.18",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "kysely": "0.29.8",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
