# The login switch: 1 on, 0 off. Unset, it is on in local runs and off in Vercel production.
FEATURE_LOGIN=

# The site's own address, with no trailing slash, such as https://www.care4mind.xyz.
BETTER_AUTH_URL=

# A random string of at least 32 characters that signs user-sessions (openssl rand -base64 32).
BETTER_AUTH_SECRET=

# The pooled Neon connection string (the -pooler host); run the migration in migrations/ with a direct one.
DATABASE_URL=

# Cloudflare Turnstile's site key, built into the login pages; blank outside production means Cloudflare's test key, which needs a test secret below.
TURNSTILE_SITE_KEY=

# Cloudflare Turnstile's secret key, read on the server; Cloudflare's test secrets are refused in production.
TURNSTILE_SECRET_KEY=

# A local stand-in for Cloudflare's token check, used only by the browser tests and refused on Vercel.
TURNSTILE_VERIFY_URL=

# The Google OAuth client's id. Its authorised redirect address is this site's /api/auth/callback/google/, slash included.
GOOGLE_CLIENT_ID=

# The Google OAuth client's secret.
GOOGLE_CLIENT_SECRET=

# The API key for Brevo, which sends the emailed codes.
BREVO_API_KEY=

# A local stand-in for Brevo's send endpoint, used only by the browser tests and refused on Vercel.
BREVO_API_URL=

# The address emailed codes come from, verified in Brevo.
LOGIN_EMAIL_FROM=

# How many requests one address may make to the routes that send or redeem an emailed code or start Google sign-in before it must stop for 60 quiet seconds; a burst, not a rate (default 600).
LOGIN_ROUTE_LIMIT_BURST=

# How many requests one address may make to any other auth route before it must stop for 10 quiet seconds; a burst, not a rate (default 1000).
LOGIN_GLOBAL_LIMIT_BURST=

# Whether the limits per email and the cap on new accounts refuse: 1 blocks, 0 or unset only records.
LOGIN_LIMITS_BLOCKING=

# How many emailed codes one address may be sent per hour (default 10, provisional until the trial).
LOGIN_CODES_PER_EMAIL_PER_HOUR=

# How many new accounts the whole site may take per hour (default 500, provisional until the trial).
LOGIN_NEW_ACCOUNTS_PER_HOUR=

# Whether a bot BotID finds is refused: 1 blocks, 0 or unset only records.
LOGIN_BOTID_BLOCKING=

# How many new accounts in one hour email the developer (default 100, provisional until the trial).
LOGIN_SPIKE_NEW_ACCOUNTS_PER_HOUR=

# The developer's address, which the sign-up spike alert is sent to.
LOGIN_ALERT_EMAIL=
