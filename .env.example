# The login switch: 1 on, 0 off. Unset, it is on in local runs and off in Vercel production.
FEATURE_LOGIN=

# The site's own address, with no trailing slash, such as https://www.care4mind.xyz.
BETTER_AUTH_URL=

# A random string of at least 32 characters that signs user-sessions (openssl rand -base64 32).
BETTER_AUTH_SECRET=

# The pooled Neon connection string (the -pooler host); run the migration in migrations/ with a direct one.
DATABASE_URL=

# Cloudflare Turnstile's site key, built into the login pages; outside production it defaults to Cloudflare's test key.
TURNSTILE_SITE_KEY=

# Cloudflare Turnstile's secret key, read on the server; Cloudflare's test secrets are refused in production.
TURNSTILE_SECRET_KEY=

# A local stand-in for Cloudflare's token check, used only by the browser tests and refused on Vercel.
TURNSTILE_VERIFY_URL=

# The Google OAuth client's id. Its authorised redirect address is this site's /api/auth/callback/google/, slash included.
GOOGLE_CLIENT_ID=

# The Google OAuth client's secret.
GOOGLE_CLIENT_SECRET=

# The API key for Brevo, which sends the emailed codes.
BREVO_API_KEY=

# A local stand-in for Brevo's send endpoint, used only by the browser tests and refused on Vercel.
BREVO_API_URL=

# The address emailed codes come from, verified in Brevo.
LOGIN_EMAIL_FROM=

# How many requests one address may make per minute to the routes that send or redeem an emailed code and start Google sign-in (default 600).
LOGIN_ROUTE_LIMIT_PER_MINUTE=

# How many requests one address may make per 10 seconds to any other auth route (default 1000).
LOGIN_GLOBAL_LIMIT_PER_10_SECONDS=
